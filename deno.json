    "lint": "deno lint"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@discord-player/extractor": "npm:@discord-player/extractor",
    "discord.js": "npm:discord.js@14.21.0",
    "@discordjs/rest": "npm:@discordjs/rest@2.5.1",
    "discord-api-types/v10": "npm:discord-api-types@0.38.16/v10",
    "discord-player": "npm:discord-player",
    "env-var": "npm:env-var",
    "winston": "npm:winston"
  },
  "nodeModulesDir": "auto"
}
